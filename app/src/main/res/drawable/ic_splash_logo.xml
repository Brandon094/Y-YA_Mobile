<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Forzamos un círculo blanco como base del icono -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- El logo de YÁYA centrado y con bastante aire (padding) -->
    <item
        android:bottom="48dp"
        android:left="48dp"
        android:right="48dp"
        android:top="48dp">
        <bitmap
            android:src="@drawable/ic_logo"
            android:gravity="center" />
    </item>
</layer-list>
